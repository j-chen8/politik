# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-staging-landtag/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database
*.db
*.db-wal
*.db-shm
*.db.backup-*
*.db.snapshot-*
politik.db.snapshot-*
.politik-db-sync-state

# pipeline state (resume-caches, batch state, large XML sources)
*.partial.jsonl
*.partial.*.jsonl
*.partial.jsonl.backup-*
.batch-state*.json
.batch-state*.json.done-*
__pycache__/
/data/plenarprotokolle_xml/*.xml
/data/stammdaten/
scripts/state/

# scratch: throwaway debug/inspection scripts + editor backups
scripts/_*.ts
*.bak

# CSV-Exports (reproduzierbar via scripts/export-tables-csv.ts)
/data/exports/

# generated assets (regeneratable via scripts/seed-photos-wikidata.ts)
/public/photos/

# Drucksachen-PDFs (reproduzierbar via scripts/download-missing-drucksachen.sh, 1.8 GB)
/data/drucksachen/

# Berlin-Pilot: PARDOK-XML + PDFs (reproduzierbar via parlament-berlin.de/opendata)
/data/berlin/

# Geodaten für PLZ→Wahlkreis-Verschnitt (reproduzierbar, Quellen + Download im
# Header von scripts/seed-plz-wahlkreis.ts; ~12 MB, u.a. plz-5stellig.geojson)
/data/geo/

# playwright mcp temp
.playwright-mcp/

# screenshots
*.png
.groq-rate-state.json
.batch-state-berlin/
.batch-state-berlin-ds/
.batch-state-berlin-votes/
.batch-state-bundestag-votes/
.backup/

# Internes CV-Konflikt-Arbeitsblatt (nicht committen)
public/cv-konflikte.html
berlin-cv-konflikte.html
berlin-cv-konflikte-manuell.md

# Themen-Unterthemen Scratch (Spike-Logs + Batch-State)
aw-spike-*.log
scripts/.batch-wohnen-unterthemen.json
berlin-wohnen-unterthemen.png
.playwright-mcp/
