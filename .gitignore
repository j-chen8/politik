# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database
*.db
*.db-wal
*.db-shm
*.db.backup-*
*.db.snapshot-*
politik.db.snapshot-*
.politik-db-sync-state

# pipeline state (resume-caches, batch state, large XML sources)
*.partial.jsonl
*.partial.*.jsonl
*.partial.jsonl.backup-*
.batch-state*.json
/data/plenarprotokolle_xml/*.xml
/data/stammdaten/

# CSV-Exports (reproduzierbar via scripts/export-tables-csv.ts)
/data/exports/

# generated assets (regeneratable via scripts/seed-photos-wikidata.ts)
/public/photos/

# Drucksachen-PDFs (reproduzierbar via scripts/download-missing-drucksachen.sh, 1.8 GB)
/data/drucksachen/

# playwright mcp temp
.playwright-mcp/

# screenshots
*.png
.groq-rate-state.json
